---
//components
import Layout from "../layouts/Layout.astro"
import Nav from "../components/Nav.astro"
import DesktopNav from "../components/DesktopNav.astro";
import EmailCTA from "../components/EmailCTA.astro";
---

<Layout backgroundColor="black" bleedMarksColor="white" title="Archive">
    <section class="logo-box">
        <Nav color="white"/>
    </section>
    <section class="nav-box">
        <DesktopNav activePage="archive" color="white" addClass="archiveNav"/>
    </section>
    <EmailCTA color="white--blackfill"/>
    <section class="archive" id="archive">
        <img src="/archive--new/Wanderfleur.webp" alt="" class="draggable wanderfleur">
        <img src="/archive--new/Sarap_2.webp" alt="" class="draggable sarap--two">
        <img src="/archive--new/ManananggalFiles_1.gif" alt="" class="draggable manananggal--one">
        <img src="/archive--new/Kalinto.webp" alt="" class="draggable kalinto">
        <img src="/archive--new/Hidden Teeth.webp" alt="" class="draggable hidden-teeth">
        <img src="/archive--new/The Attic_1.webp" alt="" class="draggable attic--one">
        <img src="/archive--new/Collage_Team.webp" alt="" class="draggable team">
        <img src="/archive--new/Susanna Clarke.webp" alt="" class="draggable clarke">
        <img src="/archive--new/Blood and Butter.webp" alt="" class="draggable blood">
        <img src="/archive--new/Manananggal Files_3.webp" alt="" class="draggable manananggal--three">
        <img src="/archive--new/Gusto.webp" alt="" class="draggable gusto">
        <img src="/archive--new/EJ Espino.webp" alt="" class="draggable ej">
        <img src="/archive--new/Salud.webp" alt="" class="draggable salud">
        <img src="/archive--new/Collage_Out for Delivery.webp" alt="" class="draggable delivery">
        <img src="/archive--new/Manananggal Files_2.webp" alt="" class="draggable manananggal--two">
        <img src="/archive--new/Manahanan.webp" alt="" class="draggable manahanan">
        <img src="/archive--new/Why Are You Here.webp" alt="" class="draggable why">
        <img src="/archive--new/Sarap_1.webp" alt="" class="draggable sarap--one">
        <img src="/archive--new/Dehusk.gif" alt="" class="draggable dehusk">
        <img src="/archive--new/The Attic_2.webp" alt="" class="draggable attic--two">
        <img src="/archive--new/Stork.webp" alt="" class="draggable stork">
        <img src="/archive--new/The Bear.webp" alt="" class="draggable bear">
        <img src="/archive--new/Wahunomi.webp" alt="" class="draggable wahunomi">
        <img src="/archive--new/Collage_Derry Girl.webp" alt="" class="draggable derry">
    </section>
</Layout>

