---
//styles
import '../styles/global.css';
import '../styles/typography.css';

//components
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import DesktopNav from '../components/DesktopNav.astro';
import EmailCTA from '../components/EmailCTA.astro';
import PortableText from "../components/PortableText.astro";

//sanity
import { sanityClient } from "sanity:client";
const about = await sanityClient.fetch(`*[_type == "about"][0]`);

//sanity imagebuilder
import imageUrlBuilder from '@sanity/image-url'
const builder = imageUrlBuilder(sanityClient)
function urlFor(source) {
  return builder.image(source)
}
---

<Layout bleedMarksColor='white' title='About' backgroundColor='purple'>
    <div class="smiley draggable"><img src="/icons/smiley--white.svg" alt="Smiley Icon"></div>
    <div class="peace draggable"><img src="/icons/peace--white.svg" alt="Peace Icon"></div>
    <div class="star draggable"><img src="/icons/star-polygon--white.svg" alt="Star Icon"></div>
    <EmailCTA color='white'/>
    <main>
        <section class="box">
            <Nav color='white' addClass='nav--about' />
            <DesktopNav color='white' activePage='about' addClass='desktopNav--about'/>
            <div class="heading">
                <div class="heading-box">
                    <PortableText portableText={about.heading}>
                </div>
                <div class="heading__description-box">
                    <PortableText portableText={about.description}>
                </div>
            </div>
            <div class="photo">
                <div class="pegboard draggable"><img src="/icons/photo--pegboard.webp" alt="pegboard photo"></div>
                <picture>
                    <img src={urlFor(about.image).url()} alt={about.image.alt}>
                </picture>
                { about.links && <div class="contact desktop">
                    {about.links.map((item, index) => (
                        <a href={item.link?.current} target={index === 0 ? undefined : "_blank"} class="small--underline">{item.text}</a>
                    ))}
                    <div class="credit">
                        <span>Website made by <a href="https://kaidostudio.pages.dev" target="_blank" class="small--underline">Gian Caedo</a></span>
                    </div>
                </div> }
            </div>
            <div class="info">
                <div class="info__item">
                    <h2>Selected Clients</h2>
                    <div class="columns">
                        <div class="column">
                            <PortableText portableText={about.clients}></PortableText>
                        </div>
                    </div>
                </div>
                <div class="info__item">
                    <h2>Features</h2>
                    { about.features && <div class="column">
                        {about.features.map((item) => (
                            <a target="_blank" href={item.link?.current}>{item.text}</a>
                        ))}
                    </div> }
                </div>
                <div class="info__item">
                    <h2>Dream Projects</h2>
                    <div class="column">
                        <PortableText portableText={about.dreamProjects}></PortableText>
                    </div>
                </div>
            </div>
            { about.links && <div class="contact mobile">
                {about.links.map((item, index) => (
                    <a href={item.link?.current} target={index === 0 ? undefined : "_blank"} class="small--underline">{item.text}</a>
                ))}
                <div class="credit">
                    <span>Website made by <a href="https://kaidostudio.pages.dev" target="_blank" class="small--underline">Gian Caedo</a></span>
                </div>
            </div> }
        </section>
    </main>
</Layout>

<style is:global>
    .nav--about {
        @media  (width > 430px) {
            grid-column: 1/13;
            margin-bottom: 64px;
        }
        
        @media  (width > 1024px) {
            grid-column: 1/5;
            margin-bottom: 8px;
            align-items: start !important;
        }
    }
    .desktopNav--about {
        @media  (width > 1024px) {
            position: absolute;
            bottom: 64px;
        }
    }
</style>

<style>
    .pegboard {
        width: 110px;
        right: 64px;
        top: 400px;

        @media (width > 430px) {
            right: 200px;
            top: 1100px;
            width: 220px;
        }

        @media (width > 1024px) {
            width: 110px;
            right: -40px;
            top: 20px;
        }
    }
    .smiley {
        top: 1070px;  
        right: 57px;
        width: 31px;

        @media (width > 430px) {
            right: 45px;
            top: 671px;
            width: 49px;
        }
        
        @media (width > 1024px) {
            left: 333px;
            right: unset;
            top: 495px;
            width: 31px;
        }
        
        @media (width > 1920px) {
            left: 425px;
            top: 587px;
        }
    }
    .peace {
        top: 1209px;  
        right: 95px;
        width: 34px;

        @media (width > 430px) {
            top: 1627px;
            right: 90px;
            width: 52px;
        }
        
        @media (width > 1024px) {
            left: 705px;
            right: unset;
            top: unset;
            bottom: 64px;
            width: 34px;
        }
        
        @media (width > 1920px) {
            left: 601px;
            top: 793px;
        }
    }
    .star {
        top: 1345px;  
        right: 31px;
        width: 30px;

        @media (width > 430px) {
            right: 83px;
            top: 894px;
            width: 64px;
        }
        
        @media (width > 1024px) {
            right: 217px;
            top: 230px;
            width: 30px;
        }
    }
    main {
        >.box {
            display: flex;
            flex-direction: column;
            gap: 24px;
            padding: 24px;

            @media (width > 430px) {
                display: grid;
                grid-template-columns: repeat(12,1fr);
                padding: 64px;
                gap: 0px;
            }

            @media (width > 1024px) {
                grid-template-columns: repeat(20, 1fr);
                height: 100svh;
                box-sizing: border-box;
                padding: 56px 64px;
            }

            >.heading {
                display: flex;
                flex-direction: column;
                gap: 24px;
                color: white;

                @media (width >430px) {
                    grid-column: 1/13;
                    margin-bottom: 64px;
                }
                
                @media (width >1024px) {
                    grid-column: 1/7;
                    margin-bottom: 0px;
                    grid-row: 2/4;
                    text-wrap: balance;
                }
                
                @media (width >1440px) {
                    grid-column: 1/6;
                }
                
                @media (width >1920px) {
                    margin-top: 20px;
                }

                >h1 {
                    font-size: var(--h3);

                    @media (width >430px) {
                        font-size: var(--h1);
                    }
                    
                    @media (width >1024px) {
                        font-size: var(--h4);
                    }

                    @media (width >=1920px) {
                        font-size: 2.0625rem;
                        line-height: 110%;
                        max-width: 439px;
                    }
                }

                > .heading__description-box {
                    font-size: var(--h5);
                    font-family: Fern-Text;
                    text-wrap: pretty;
                    
                    @media (width >430px) {
                        font-size: var(--h3);
                        line-height: 128%;
                    }
                    
                    @media (width >1024px) {
                        font-size: var(--small);
                        line-height: 128%;
                        display: inline-block;
                    }
                    
                    @media (width >= 1920px) {
                        font-size: 0.875rem;
                        line-height: 140%;
                        max-width: 439px;
                    }

                    >a {
                        color: white;
                        transition: var(--transition);
                        display: inline-block;

                        &:hover {
                            transform: translateY(-2px);
                        }
                    }
                }
            }

            >.info {
                display: flex;
                flex-direction: column;
                gap: 48px;
                color: white;
                margin-top: 40px;
                
                @media (width >430px) {
                    margin-top: 0px;
                    grid-column: 1/6;
                    grid-row: 3/5;
                }
                
                @media (width >1024px) {
                    grid-column: 8/12;
                    grid-row: 2/3;
                    gap: 68px;
                }

                >.info__item {
                    display: flex;
                    flex-direction: column;
                    gap: 8px;

                    >h2 {
                        font-size: var(--medium);
                        font-family: Jet-Brains-Mono;
    
                        @media (width >430px) {
                            font-size: var(--x-large);
                        }
    
                        @media (width >1024px) {
                            font-size: var(--medium);
                        }
    
                        @media (width >= 1920px) {
                            font-size: 1rem;
                        }
                    }
    
                    >.columns{
                        font-size: var(--small);
                        display: flex;
                        flex-direction: column;
                        gap: 10%;
                        
                        @media (width >430px) {
                            font-size: var(--medium);
                        }
                        
                        @media (width >1024px) {
                            font-size: var(--x-small);
                            gap: 32px;
                        }
    
                        @media (width >= 1920px) {
                            font-size: 0.75rem;
                            line-height: 140%;
                            letter-spacing: 0.5px;
                            max-width: 358px;
                        }
    
                        >.column {
                            display: flex;
                            flex-direction: column;
                            gap: 2px;
                        }
                    }
    
                    >.column {
                        font-size: var(--small);
                        display: flex;
                        flex-direction: column;
                        gap: 2px;
    
                        @media (width >430px) {
                            font-size: var(--medium);
                        }
                        
                        @media (width >1024px) {
                            font-size: var(--x-small);
                            line-height: 140%;
                            letter-spacing: 0.5px;
                            gap: 6px;
                        }
                        
                        @media (width >= 1920px) {
                            font-size: 0.75rem;
                            gap: 6px;
                        }
    
                        > a {
                            font-family: Jet-Brains-Mono;
                            color: white;
                            font-size: var(--small);
                            text-decoration: underline;
                            font-style: italic;
                            transition: var(--transition);
                            
                            &:hover {
                                transform: translate3d(4px, -4px, 0px);
                            }
    
                            @media (width >430px) {
                                font-size: var(--medium);
                            }
                        
                            @media (width >1024px) {
                                font-size: var(--x-small);
                            }
    
                            @media (width >= 1920px) {
                                font-size: 0.75rem;
                                line-height: 140%;
                            }

                            &::before {
                                content: '↗ ';
                            }
                        }
                    }
                }

            }

            >.photo {
                margin-top: 40px;
                position: relative;

                @media (width >430px) {
                    grid-column: 1/11;
                    grid-row: 6;
                    margin-top: 64px;
                }
                
                @media (width >1024px) {
                    grid-column: 14/18;
                    grid-row: 2/4;
                    margin-top: 0px;
                }
            }
        }
    }
    .contact {
        display: flex;
        flex-direction: column;
        gap: 3px;
        
        @media (width >430px) {
            gap: 8px;
            grid-column: 11/13;
            grid-row: 6;
            align-self: end;
        }

        @media (width >1024px) {
            gap: 3px;
            grid-column: 14/18;
            grid-row: 4;
            align-self: start;
        }

        >a{
            font-family: Jet-Brains-Mono;
            font-size: var(--small);
            color: white;
            transition: var(--transition);
            
            &:hover {
                transform: translate3d(4px, -4px, 0px);
            }
            
            @media (width >430px) {
                font-size: var(--small);
            }

            @media (width >1024px) {
                font-size: var(--x-small);
            }

            @media (width >= 1920px) {
                font-size: 0.75rem;
                line-height: 140%;
                letter-spacing: 0.5px;
            }

            &::before {
                content: '↗ ';
            }
        }

        >.credit {
            margin-top: 16px;
            font-size: var(--x-small);
            color: white;
            
            >span   >a {
                color: white;
                transition: var(--transition);

                &:hover {
                    color: var(--gray);
                    transform: translateY(-2px);
                }
            }

            @media (width >= 1920px) {
                font-size: 0.75rem;
                line-height: 140%;
                letter-spacing: 0.5px;
                margin-top: 24px;
            }
        }

        &.mobile {
            @media (width > 1024px) {
                display: none;
            }
        }

        &.desktop {
            display: none;

            @media (width > 1024px) {
                display: flex;
                margin-top: 24px;
            }

            @media (width >= 1920px) {
                display: flex;
                margin-top: 40px;
            }
        }
    }
</style>

<style is:global>
    .heading__description-box > p {
        font-size: var(--h5);
        font-family: Fern-Text;
        text-wrap: pretty;
        
        @media (width >430px) {
            font-size: var(--h3);
            line-height: 128%;
        }
        
        @media (width >1024px) {
            font-size: var(--small);
            line-height: 128%;
            display: inline-block;
        }
        
        @media (width >= 1920px) {
            font-size: 0.875rem;
            line-height: 140%;
            max-width: 439px;
        }

        >a {
            color: white;
            transition: var(--transition);
            display: inline-block;
            text-decoration: underline;

            &:hover {
                transform: translateY(-2px);
            }
        }
    }
</style>